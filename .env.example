# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=records
POSTGRES_USER=records
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://records:change-me@db:5432/records
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173
UPLOAD_FOLDER=/app/uploads

# development or production
APP_ENV=development
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
# Where the browser is sent after login. Empty means same origin.
FRONTEND_URL=

# AAF Rapid Connect
# e.g. https://rapid.test.aaf.edu.au/jwt/authnrequest/research/<your-id>
AAF_RAPID_CONNECT_URL=
# Shared secret from your Rapid Connect registration
AAF_SECRET=
AAF_ISSUER=https://rapid.test.aaf.edu.au
# The service URL you registered, e.g. https://records.example.org
AAF_AUDIENCE=
# Local development only: skip AAF and sign in as a fake user.
# The app refuses to start with this on when APP_ENV=production.
AAF_MOCK=true
