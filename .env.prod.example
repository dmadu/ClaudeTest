# Production settings. Copy to .env.prod and fill in every value. Never commit .env.prod.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# The domain name people will use (no https://). Caddy gets a certificate for it automatically.
# Its DNS must point at this server, and ports 80 and 443 must be open.
SITE_ADDRESS=records.example.org

# Database. Use letters, digits, "-" and "_" only in the password (token_urlsafe does).
POSTGRES_DB=records
POSTGRES_USER=records
POSTGRES_PASSWORD=

# Signs the session cookie. At least 32 random characters.
SECRET_KEY=

# AAF Rapid Connect, from your production registration (see docs/deployment.md).
# Production federation: https://rapid.aaf.edu.au   Test federation: https://rapid.test.aaf.edu.au
AAF_ISSUER=https://rapid.aaf.edu.au
AAF_RAPID_CONNECT_URL=
AAF_SECRET=
# The service URL you registered, for example https://records.example.org
AAF_AUDIENCE=

# Backups
# Folder on this server. Copy it to another machine as well, or a lost server loses its backups too.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Optional
# HSTS_MAX_AGE=31536000    # use 0 only for a rehearsal on localhost
# HTTP_PORT=80
# HTTPS_PORT=443
# WEB_CONCURRENCY=1        # more than 1 needs a shared rate-limit store (see docs/deployment.md)
